            display(DisplayHTML("<h3>Live Bloomberg Curve Members</h3>"))
            display(self.snapshot.curve.round(6))

            display(DisplayHTML("<h3>Bootstrapped Discount Factors</h3>"))
            display(self.curve.nodes.round(8))

    def _render_method(self):
        with self.method:
            clear_output()
            display(DisplayHTML(f"""
            <h3>Methodology</h3>
            <ol>
              <li>Load live Bloomberg curve object <b>{self.config.curve_ticker}</b>.</li>
              <li>Bootstrap discount factors from the curve's par rates using explicit country conventions.</li>
              <li>Use the actual central-bank meeting dates rather than MIPR's 1M / 3M / 6M buckets.</li>
              <li>For each meeting, compute the simple forward rate for the period from that meeting until the next meeting using Bloomberg's published MIPR identity:<br>
              <code>r = (D(start)/D(end) - 1) / t</code></li>
              <li>First-meeting pricing compares the implied post-meeting O/N rate with today's effective rate.</li>
              <li>Subsequent meeting pricing compares successive implied post-meeting rates.</li>
              <li>Divide the incremental basis-point move by the country's configured standard move to obtain # hikes/cuts.</li>
            </ol>
            <p><b>Convention status:</b> {self.config.convention_status}</p>
            <p><b>Important:</b> Official meeting dates are used where configured. Dates marked Estimated are model assumptions and should not be presented as announced meetings.</p>
            """))


