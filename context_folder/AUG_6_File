@dataclass
class MarketSnapshot:
    curve: pd.DataFrame
    policy_rate: float
    policy_source: str
    curve_source: str
    quote_date: pd.Timestamp
    as_of_date: pd.Timestamp


class BloombergMarketData:

    @staticmethod
    def service():
        if bql is None:
            raise RuntimeError("BQL is unavailable. Run inside Bloomberg BQuant.")
        return bql.Service()

    @staticmethod
    def _find_col(df, names):
        lower = {str(c).lower(): c for c in df.columns}
        for name in names:
            if name.lower() in lower:
                return lower[name.lower()]
        for c in df.columns:
            lc = str(c).lower()
            if any(name.lower() in lc for name in names):
                return c
        return None

    @classmethod
    def _merge_responses(cls, responses, context):
        frames = [r.df().reset_index() for r in responses if not r.df().empty]
        if not frames:
            raise RuntimeError(f"No Bloomberg data returned for {context}.")
        if len(frames) == 1:
            return frames[0]

        out = frames[0]
        for nxt in frames[1:]:
            shared = [c for c in ("ID", "DATE", "ID_DATE") if c in out.columns and c in nxt.columns]
            if not shared and "ID" in out.columns and "ID" in nxt.columns:
                shared = ["ID"]
            if not shared:
                raise RuntimeError(
                    f"Cannot merge BQL response tables for {context}: "
                    f"{list(out.columns)} / {list(nxt.columns)}"
                )
            out = out.merge(nxt.drop_duplicates(shared), on=shared, how="outer", suffixes=("", "_dup"))
            for c in [x for x in out.columns if str(x).endswith("_dup")]:
                base = str(c)[:-4]
                if base in out.columns:
                    out[base] = out[base].where(out[base].notna(), out[c])
                out.drop(columns=[c], inplace=True)
        return out

    @classmethod
    def load_curve(cls, config: CountryConfig, as_of: pd.Timestamp):
        svc = cls.service()
        selected = pd.Timestamp(as_of).normalize()
        today = pd.Timestamp.today().normalize()

        universe = svc.univ.curvemembers(symbols=config.curve_ticker)

        if selected >= today:
            rate_item = svc.data.curve_rate(side="MID")
            source = f"Live BQL curve object {config.curve_ticker}"
        else:
            date_text = selected.strftime("%Y-%m-%d")
            try:
                rate_item = svc.data.curve_rate(side="MID", dates=date_text)
            except Exception:
                rate_item = svc.data.curve_rate(side="MID", dates=selected)
            source = f"Historical BQL curve object {config.curve_ticker}"

        req = bql.Request(
            universe,
            {
                "curve_rate": rate_item,
                "maturity": svc.data.maturity(),
            },
        )
        raw = cls._merge_responses(svc.execute(req), config.curve_ticker)

        id_col = cls._find_col(raw, ["ID", "ticker"])
        rate_col = cls._find_col(raw, ["curve_rate", "rate"])
        mat_col = cls._find_col(raw, ["maturity"])
        date_col = cls._find_col(raw, ["DATE", "ID_DATE"])

        if id_col is None or rate_col is None:
            raise RuntimeError(f"Unexpected BQL curve response columns: {list(raw.columns)}")

        frame = pd.DataFrame({
            "ticker": raw[id_col].astype(str),
            "par_rate": pd.to_numeric(raw[rate_col], errors="coerce"),
        })

        # Some BQuant releases do not return maturity for curve members.
        if mat_col is not None:
            frame["maturity"] = pd.to_datetime(raw[mat_col], errors="coerce")
            frame["tenor_days"] = (frame["maturity"] - selected).dt.days
        else:
            raise RuntimeError(
                "Curve member maturity was not returned. "
                "Please verify bq.data.maturity() works for this curve object."
            )

        frame["quote_date"] = selected
        if date_col is not None:
            parsed = pd.to_datetime(raw[date_col], errors="coerce")
            frame["quote_date"] = parsed.fillna(selected).dt.normalize()

        frame = frame.dropna(subset=["par_rate", "tenor_days"])
        frame = frame[(frame["tenor_days"] > 0) & (frame["tenor_days"] <= 10 * 365)]
        frame = frame.sort_values("tenor_days").drop_duplicates("tenor_days")

        if len(frame) < 5:
            raise RuntimeError(f"Only {len(frame)} usable curve nodes returned for {config.name}.")

        frame["source"] = source
        return frame.reset_index(drop=True)

    @classmethod
    def load_policy(cls, config: CountryConfig, as_of: pd.Timestamp):
        if not config.policy_ticker:
            return config.policy_rate_fallback, "Editable configured fallback"

        svc = cls.service()
        selected = pd.Timestamp(as_of).normalize()
        today = pd.Timestamp.today().normalize()

        if selected >= today:
            item = svc.data.px_last()
            source = f"Live BQL {config.policy_ticker}"
        else:
            date_text = selected.strftime("%Y-%m-%d")
            try:
                item = svc.data.px_last(dates=date_text)
            except Exception:
                item = svc.data.px_last(dates=selected)
            source = f"Historical BQL {config.policy_ticker}"

        try:
            req = bql.Request([config.policy_ticker], {"policy": item})
            raw = cls._merge_responses(svc.execute(req), config.policy_ticker)
            val_col = cls._find_col(raw, ["policy", "px_last", "value"])
            vals = pd.to_numeric(raw[val_col], errors="coerce").dropna()
            if not vals.empty:
                return float(vals.iloc[-1]), source
        except Exception:
            pass

        return config.policy_rate_fallback, "Editable configured fallback"

    @classmethod
    def snapshot(cls, config: CountryConfig, as_of: pd.Timestamp):
        curve = cls.load_curve(config, as_of)
        policy, policy_source = cls.load_policy(config, as_of)
        qd = pd.to_datetime(curve["quote_date"], errors="coerce").dropna()
        quote_date = qd.max() if not qd.empty else pd.Timestamp(as_of).normalize()
        return MarketSnapshot(
            curve=curve,
            policy_rate=policy,
            policy_source=policy_source,
            curve_source=str(curve["source"].iloc[0]),
            quote_date=pd.Timestamp(quote_date).normalize(),
            as_of_date=pd.Timestamp(as_of).normalize(),
        )



