@dataclass
class DiscountCurve:
    node_days: np.ndarray
    node_dfs: np.ndarray
    log_df_interp: PchipInterpolator
    config: CountryConfig
    nodes: pd.DataFrame

    def df(self, day):
        day = float(day)
        if day <= 0:
            return 1.0
        if day > self.node_days[-1]:
            raise ValueError(
                f"Requested day {day:.0f} exceeds available curve horizon "
                f"{self.node_days[-1]:.0f}."
            )
        return float(np.exp(self.log_df_interp(day)))


def _payment_schedule(maturity_day, frequency_days):
    if maturity_day <= frequency_days:
        return [int(maturity_day)]
    dates = list(range(frequency_days, int(maturity_day), frequency_days))
    dates.append(int(maturity_day))
    return dates


def bootstrap_discount_curve(market_curve: pd.DataFrame, config: CountryConfig):
    quotes = (
        market_curve[["ticker", "par_rate", "tenor_days"]]
        .dropna()
        .sort_values("tenor_days")
        .drop_duplicates("tenor_days")
    )

    node_days = [0.0]
    node_dfs = [1.0]
    output = []

    def interp_df(day, candidate_day=None, candidate_df=None):
        days = np.asarray(node_days, float)
        dfs = np.asarray(node_dfs, float)
        if candidate_day is not None:
            days = np.r_[days, float(candidate_day)]
            dfs = np.r_[dfs, float(candidate_df)]
        order = np.argsort(days)
        return float(np.exp(np.interp(float(day), days[order], np.log(dfs[order]))))

    for _, row in quotes.iterrows():
        maturity = int(row["tenor_days"])
        k = float(row["par_rate"]) / 100.0
        schedule = _payment_schedule(maturity, config.fixed_payment_frequency_days)

        def objective(last_df):
            annuity = 0.0
            prev = 0
            for pay_day in schedule:
                alpha = (pay_day - prev) / config.day_count_basis
                annuity += alpha * interp_df(pay_day, maturity, last_df)
                prev = pay_day
            return k * annuity - (1.0 - last_df)

        lower, upper = 1e-8, 2.0
        try:
            solved = brentq(objective, lower, upper, maxiter=500)
        except ValueError as exc:
            raise RuntimeError(
                f"Bootstrap failed for {config.name} at node {maturity}d. "
                "This usually means the configured swap convention needs adjustment."
            ) from exc

        node_days.append(float(maturity))
        node_dfs.append(float(solved))
        output.append({
            "ticker": row["ticker"],
            "tenor_days": maturity,
            "market_par_rate": float(row["par_rate"]),
            "discount_factor": float(solved),
        })

    interp = PchipInterpolator(
        np.asarray(node_days),
        np.log(np.asarray(node_dfs)),
        extrapolate=False,
    )
    return DiscountCurve(
        node_days=np.asarray(node_days),
        node_dfs=np.asarray(node_dfs),
        log_df_interp=interp,
        config=config,
        nodes=pd.DataFrame(output),
    )



