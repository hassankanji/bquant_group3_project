            ]),
            widgets.HBox([self.policy, self.effective]),
            self.status,
            self.tabs,
        ])

        self.country.observe(self._country_changed, names="value")
        self.live.observe(self._live_changed, names="value")
        self.extend.observe(lambda _: self.run(refresh=False), names="value")
        self.refresh.on_click(lambda _: self.run(refresh=True))

    def display(self):
        display(self.root)

    def _selected_date(self):
        if self.live.value:
            today = pd.Timestamp.today().normalize()
            self.as_of.value = today.date()
            return today
        return pd.Timestamp(self.as_of.value).normalize()

    def _country_changed(self, change):
        self.config = COUNTRIES[change["new"]]
        self.policy.value = self.config.policy_rate_fallback
        self.effective.value = self.config.effective_rate_fallback
        self.snapshot = None
        self.run(refresh=True)

    def _live_changed(self, change):
        self.as_of.disabled = bool(change["new"])
        self.refresh.description = (
            "Refresh live Bloomberg" if change["new"]
            else "Load historical Bloomberg"
        )
        self.snapshot = None
        self.run(refresh=True)

    def run(self, refresh=True):
        try:
            selected = self._selected_date()

            if refresh or self.snapshot is None:
                self.snapshot = BloombergMarketData.snapshot(self.config, selected)

                # If a verified live policy ticker exists, populate it.
                if "Live BQL" in self.snapshot.policy_source or "Historical BQL" in self.snapshot.policy_source:
                    self.policy.value = float(self.snapshot.policy_rate)

            self.calendar = build_calendar(
                self.config, selected, extend=self.extend.value
            )
            self.curve = bootstrap_discount_curve(
                self.snapshot.curve, self.config
            )
            self.path = build_wirp_path(
                self.curve,
                self.calendar,
                effective_rate=float(self.effective.value),
                policy_rate=float(self.policy.value),
                config=self.config,
            )

            self._render_status()
            self._render_main()
            self._render_curve()
            self._render_method()

        except Exception as exc:
            with self.status:
                clear_output()
                display(DisplayHTML(
                    f"<div style='color:#ff6666;font-family:monospace'>"
                    f"<b>ERROR:</b> {type(exc).__name__}: {exc}</div>"
                ))
            raise

    def _render_status(self):
        with self.status:
            clear_output()
            display(DisplayHTML(
                f"<div style='color:#aaa;font-size:12px'>"
                f"<b>{self.config.name}</b> · "
                f"Curve: {self.config.curve_ticker} · "
                f"Source: {self.snapshot.curve_source} · "
                f"Curve date: {self.snapshot.quote_date.date()} · "
                f"Policy source: {self.snapshot.policy_source}"
                f"</div>"
            ))

