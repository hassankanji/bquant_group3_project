# ============================================================
# BLOCK 6 — WIRP-style meeting segment forwards
# ============================================================

def simple_forward_from_df(curve: DiscountCurve, start_day: int, end_day: int):
    """
    Bloomberg MIPR published identity:
        D(0,end)/D(0,start) = 1 / (1 + r_f * t)

    Rearranged:
        r_f = (D(0,start)/D(0,end) - 1) / t
    """
    if end_day <= start_day:
        raise ValueError("Forward interval must have positive length.")

    d1 = curve.df(start_day)
    d2 = curve.df(end_day)
    t = (end_day - start_day) / curve.config.day_count_basis
    return ((d1 / d2) - 1.0) / t * 100.0


def build_wirp_path(
    curve: DiscountCurve,
    calendar: pd.DataFrame,
    effective_rate: float,
    policy_rate: float,
    config: CountryConfig,
):
    """
    For every meeting, calculate the forward overnight rate for the period
    AFTER that meeting and BEFORE the next meeting.

    First meeting move:
        implied post-meeting rate - current effective rate

    Later moves:
        implied rate_i - implied rate_(i-1)
    """
    cal = calendar.copy().sort_values("meeting_date").reset_index(drop=True)

    # Need an endpoint after the final displayed meeting.
    next_days = cal["days_from_as_of"].astype(int).tolist()[1:]
    final_end = int(cal["days_from_as_of"].iloc[-1] + config.estimated_cadence_days)
    next_days.append(final_end)

    max_curve_day = int(curve.node_days[-1])
    if final_end > max_curve_day:
        # Keep only meetings whose post-meeting interval fits inside the curve.
        valid = [
            i for i, end_day in enumerate(next_days)
            if end_day <= max_curve_day
        ]
        if not valid:
            raise ValueError("Curve horizon is too short for the first meeting interval.")
        last_i = max(valid)
        cal = cal.iloc[:last_i + 1].copy()
        next_days = next_days[:last_i + 1]

    implied_overnight = []
    for start_day, end_day in zip(
        cal["days_from_as_of"].astype(int),
        next_days,
    ):
        start = max(int(start_day) + config.spot_lag_days, 1)
        end = max(int(end_day) + config.spot_lag_days, start + 1)
        implied_overnight.append(simple_forward_from_df(curve, start, end))

    cal["implied_overnight_rate"] = implied_overnight

    previous_rates = np.r_[
        float(effective_rate),
        cal["implied_overnight_rate"].to_numpy()[:-1],
    ]
    cal["implied_move_bps"] = (
        cal["implied_overnight_rate"].to_numpy() - previous_rates
    ) * 100.0

    cal["hikes_cuts"] = cal["implied_move_bps"] / config.standard_move_bps
    cal["hike_cut_percent"] = cal["hikes_cuts"] * 100.0
    cal["implied_rate_delta"] = cal["implied_move_bps"] / 100.0

    # Policy-equivalent rate: preserve today's policy-effective basis.
    policy_effective_basis = float(policy_rate) - float(effective_rate)
    cal["implied_policy_rate"] = (
        cal["implied_overnight_rate"] + policy_effective_basis
    )

    cal["direction"] = np.select(
        [cal["implied_move_bps"] > 0.5, cal["implied_move_bps"] < -0.5],
        ["Hike", "Cut"],
        default="Pause",
    )

    return cal



