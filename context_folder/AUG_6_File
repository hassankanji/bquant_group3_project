                <b style="display:block;font-size:22px">{self.policy.value:.3f}%</b>
              </div>
              <div style="background:#222;border:1px solid #555;border-radius:8px;padding:12px;min-width:170px">
                <span style="color:#aaa;font-size:11px">EFFECTIVE RATE</span>
