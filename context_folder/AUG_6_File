# ============================================================
# BLOCK 4 — Calendar builder: official dates + estimated extension
# ============================================================

def following_weekday(d):
    d = pd.Timestamp(d).normalize()
    while d.weekday() >= 5:
        d += pd.Timedelta(days=1)
    return d


def build_calendar(config: CountryConfig, as_of: pd.Timestamp, extend=True):
    as_of = pd.Timestamp(as_of).normalize()
    end = as_of + pd.Timedelta(days=config.horizon_days)

    official = sorted(
        pd.Timestamp(d).normalize()
        for d in config.official_meetings
        if as_of < pd.Timestamp(d).normalize() <= end
    )

    rows = [{"meeting_date": d, "meeting_type": "Official"} for d in official]
    used = set(official)

    if extend:
        anchor = official[-1] if official else as_of
        next_d = anchor + pd.Timedelta(days=config.estimated_cadence_days)

        while next_d <= end:
            est = following_weekday(next_d)
            while est in used:
                est = following_weekday(est + pd.Timedelta(days=1))
            rows.append({"meeting_date": est, "meeting_type": "Estimated"})
            used.add(est)
            next_d = est + pd.Timedelta(days=config.estimated_cadence_days)

    cal = pd.DataFrame(rows).sort_values("meeting_date").reset_index(drop=True)
    if cal.empty:
        raise ValueError(f"No future meeting dates for {config.name}.")
    cal["days_from_as_of"] = (cal["meeting_date"] - as_of).dt.days
    return cal



