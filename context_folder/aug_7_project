def build_forward_curve_figure(curve, path, as_of, policy_rate):
    """Step forward curve on top, implied policy rate per meeting beneath."""
    as_of = pd.Timestamp(as_of).normalize()
    fig = make_subplots(rows=2, cols=1, row_heights=[0.58, 0.42],
                        vertical_spacing=0.13,
                        subplot_titles=("Bootstrapped CC forward curve (step function)",
                                        "Implied policy rate at each meeting"))

    xs, ys = [], []
    for a, b, f in zip(curve.node_days[:-1], curve.node_days[1:], curve.fwds):
        xs += [as_of + pd.Timedelta(days=float(a)), as_of + pd.Timedelta(days=float(b))]
        ys += [f * 100.0, f * 100.0]
    fig.add_trace(go.Scatter(x=xs, y=ys, mode="lines", name="CC forward (step)",
                             line={"color": COLORS[0], "width": 2}), row=1, col=1)

    last = curve.node_days[-1]
    fig.add_trace(go.Scatter(
        x=[as_of + pd.Timedelta(days=float(last)),
           as_of + pd.Timedelta(days=float(last) + 365)],
        y=[curve.fwds[-1] * 100.0] * 2, mode="lines", name="flat extrapolation",
        line={"color": COLORS[2], "width": 2, "dash": "dot"}), row=1, col=1)

    if path is not None and not path.empty:
        rates = [policy_rate] + list(path["implied_policy_rate"])
        labels = ["Current"] + [pd.Timestamp(d).strftime("%d %b %y")
                                for d in path["meeting_date"]]
        colours = [COLORS[2]] + ["#ffa726" if r >= policy_rate else "#ef5350"
                                 for r in path["implied_policy_rate"]]
        fig.add_trace(go.Bar(x=labels, y=rates, marker={"color": colours},
                             text=[f"{r:.3f}" for r in rates],
                             textposition="outside", showlegend=False,
                             name="Implied policy rate"), row=2, col=1)
        lo, hi = min(rates), max(rates)
        pad = max(0.08, (hi - lo) * 0.40)
        fig.update_yaxes(range=[lo - pad, hi + pad], row=2, col=1)
        fig.add_hline(y=policy_rate, line_dash="dash", line_color="orange",
                      line_width=1, row=2, col=1)

    fig.update_yaxes(title_text="CC forward (%)", row=1, col=1)
    fig.update_yaxes(title_text="Implied policy rate (%)", row=2, col=1)
    fig.update_xaxes(title_text="Maturity", row=1, col=1)
    fig.update_xaxes(type="category", row=2, col=1)
    fig.update_layout(template="plotly_dark", height=720,
                      margin=dict(t=70, r=10, l=10, b=10),
                      legend={"orientation": "h", "yanchor": "bottom",
                              "y": 1.04, "x": 0.02},
                      hovermode="x unified")
    return fig


