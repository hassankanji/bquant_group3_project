class StepForwardCurve:
    """
    Piecewise-constant continuously-compounded forwards. f_i applies on
    (T_{i-1}, T_i]. The first segment starts at t=0, so the forward before
    the first maturity is f_1 by construction; past the last node the final
    forward is held flat. log D is therefore piecewise linear.
    """

    def __init__(self, node_days, fwds):
        self.node_days = np.asarray(node_days, float)
        self.fwds = np.asarray(fwds, float)
        seg = (np.diff(self.node_days) / CC_BASIS if len(self.node_days) > 1
               else np.array([]))
        self.cum = (np.concatenate([[0.0], np.cumsum(self.fwds * seg)])
                    if len(self.fwds) else np.array([0.0]))

    @classmethod
    def empty(cls):
        c = cls.__new__(cls)
        c.node_days = np.array([0.0])
        c.fwds = np.array([])
        c.cum = np.array([0.0])
        return c

    def extend(self, T, f):
        return StepForwardCurve(np.r_[self.node_days, float(T)],
                                np.r_[self.fwds, float(f)])

    def log_df(self, day):
        d = float(day)
        if d <= 0 or len(self.fwds) == 0:
            return 0.0
        n = len(self.fwds)
        if d >= self.node_days[-1]:
            return -(self.cum[n] + self.fwds[-1] * (d - self.node_days[-1]) / CC_BASIS)
        i = max(int(np.searchsorted(self.node_days, d, side="left")), 1)
        return -(self.cum[i - 1] + self.fwds[i - 1] *
                 (d - self.node_days[i - 1]) / CC_BASIS)

    def df(self, day):
        return float(np.exp(self.log_df(day)))

    def cc_forward(self, a, b):
        if b <= a:
            return np.nan
        return -(self.log_df(b) - self.log_df(a)) / ((b - a) / CC_BASIS) * 100.0

    def simple_forward(self, a, b):
        if b <= a:
            return np.nan
        return ((self.df(a) / self.df(b) - 1.0)
                / ((b - a) / CFG.day_count_basis) * 100.0)

    def forward_table(self):
        return pd.DataFrame([
            {"from_day": int(a), "to_day": int(b),
             "cc_forward_pct": f * 100.0,
             "simple_fwd_pct": self.simple_forward(a, b)}
            for a, b, f in zip(self.node_days[:-1], self.node_days[1:], self.fwds)
        ])


def forward_par_rate_dates(curve, as_of, start, end):
    """
    Forward-starting par swap rate, which is what FWCV quotes.

        rate = (D(start) - D(end)) / Annuity

    Not the same as (D(a)/D(b) - 1)/tau: that money-market form only agrees
    when the window holds a single coupon.
    """
    as_of = pd.Timestamp(as_of).normalize()
    start, end = adjust(start), adjust(end)
    if end <= start:
        return np.nan

    off = lambda d: (pd.Timestamp(d) - as_of).days
    pays = swap_schedule(start, end)
    if not pays:
        return np.nan

    ann, prev = 0.0, start
    for p in pays:
        ann += (p - prev).days / CFG.day_count_basis * curve.df(off(p))
        prev = p
    if ann <= 0:
        return np.nan
    return (curve.df(off(start)) - curve.df(off(end))) / ann * 100.0


def _adjusted_nodes(tenor_days, as_of, maturity_dates=None):
    """
    Curve nodes must sit on the dates the instruments actually settle.

    Placing a node at the raw tenor while pricing at the business-day
    adjusted maturity breaks the bootstrap: during a solve the extra days
    are covered by flat extrapolation of the forward being solved, but once
    the next node is added the forward past T changes and the instrument
    stops repricing. Mexico's maturities all fall on business days so the
    error was invisible there; Chile and Colombia had 5 of 7 maturities on
    weekends, giving reprice errors of 0.3 and 1.6 bp.
    """
    as_of = pd.Timestamp(as_of).normalize()
    mats = ([adjust(pd.Timestamp(m).normalize()) for m in maturity_dates]
            if maturity_dates is not None
            else [adjust(as_of + pd.Timedelta(days=int(t))) for t in tenor_days])
    days = [int((m - as_of).days) for m in mats]
    return mats, days


def bootstrap_cc_forwards(tenor_days, par_rates, as_of, maturity_dates=None):
    """Solve one CC forward per instrument, in maturity order."""
    as_of = pd.Timestamp(as_of).normalize()
    s = spot_date(as_of)
    mats, node_days = _adjusted_nodes(tenor_days, as_of, maturity_dates)

    curve = StepForwardCurve.empty()
    solved = []
    for T, k, m in zip(node_days, par_rates, mats):
        T, k = int(T), float(k)
        base = curve
        try:
            f = brentq(lambda x: forward_par_rate_dates(base.extend(T, x),
                                                        as_of, s, m) - k,
                       -0.50, 2.00, maxiter=300, xtol=1e-14)
        except ValueError as exc:
            raise RuntimeError(
                f"{CFG.name}: bootstrap failed at {T}d (par {k:.4f}). The "
                f"{CFG.coupon_freq_days}-day / ACT-{CFG.day_count_basis:.0f} "
                f"convention may not match this curve."
            ) from exc
        curve = base.extend(T, f)
        solved.append({"tenor_days": T, "par_rate": k, "cc_forward_pct": f * 100.0})

    return curve, pd.DataFrame(solved)


def reprice_check(curve, tenor_days, par_rates, as_of, maturity_dates=None):
    """
    Zero by construction, so this validates the interpolation, NOT the
    convention. A wrong coupon frequency still reprices perfectly.
    """
    as_of = pd.Timestamp(as_of).normalize()
    s = spot_date(as_of)
    mats, node_days = _adjusted_nodes(tenor_days, as_of, maturity_dates)
    rows = []
    for T, k, m in zip(node_days, par_rates, mats):
        model = forward_par_rate_dates(curve, as_of, s, m)
        rows.append({"tenor_days": int(T), "market": float(k),
                     "model": model, "error_bps": (model - float(k)) * 100.0})
    return pd.DataFrame(rows)


def reliable_horizon(curve):
    """
    Last day the curve can say anything meeting-specific. Stops at the first
    segment wider than TAIL_BLOCK_DAYS, which is one flat number averaging a
    long stretch rather than pricing anything.
    """
    nd = curve.node_days
    for i in range(1, len(nd)):
        if nd[i] - nd[i - 1] > TAIL_BLOCK_DAYS:
            return float(nd[i - 1])
    return float(nd[-1])


def scenario_curve_from_path(as_of, meeting_days, overnight_path, current_rate):
    """
    Discount curve implied by a projected overnight path: flat at
    current_rate until the first meeting, then holding each level to the
    next. Simple ACT/360 accrual within a segment, converted to the
    equivalent constant CC forward so ordinary pricing routines apply.
    """
    days = [int(d) for d in meeting_days]
    rates = [float(current_rate)] + [float(r) for r in overnight_path]
    bounds = [0] + days
    bounds.append(bounds[-1] + CFG.estimated_cadence_days)

    fwds = []
    for i, r in enumerate(rates):
        span = max(bounds[i + 1] - bounds[i], 1)
        accrual = 1.0 + (r / 100.0) * (span / CFG.day_count_basis)
        fwds.append(np.log(accrual) / (span / CC_BASIS))

    return StepForwardCurve(np.array(bounds, float), np.array(fwds, float))


def scenario_position(market_curve, scen_curve, as_of, start, end,
                      notional, pay_fixed):
    """
    PV(payer) = N x Annuity x (S - K), entered at the market rate so the
    P&L is purely the scenario move. Instantaneous reprice: no carry, no
    roll-down, no spread change.
    """
    s_mkt = forward_par_rate_dates(market_curve, as_of, start, end)
    s_scn = forward_par_rate_dates(scen_curve, as_of, start, end)
    if not np.isfinite(s_mkt) or not np.isfinite(s_scn):
        return None

    ann, prev = 0.0, start
    for p in swap_schedule(start, end):
        ann += (p - prev).days / CFG.day_count_basis * market_curve.df(
            (p - pd.Timestamp(as_of).normalize()).days)
        prev = p

    sign = 1.0 if pay_fixed else -1.0
    return {"market_rate": s_mkt, "scenario_rate": s_scn,
            "rate_change_bps": (s_scn - s_mkt) * 100.0,
            "dv01": notional * ann * 1e-4,
            "pnl": sign * notional * ann * (s_scn - s_mkt) / 100.0}


