    def _on_scn_input(self, _c=None):
        self._render_scenario()

    def _set_select(self, widget, options, value=None):
        """
        Never unobserve_all here: ipywidgets keeps its own @observe('options')
        handler that refreshes _options_values, and dropping it leaves the
        value validated against a stale list.
        """
        try:
            widget.unobserve(self._on_scn_input, names="value")
        except ValueError:
            pass
        widget.options = options
        if options and value is not None:
            widget.value = value
        widget.observe(self._on_scn_input, names="value")

    def _rebuild_scenario_grid(self):
        self.scn_inputs, cells = [], []
        for _, r in self.path.iterrows():
            lbl = pd.Timestamp(r["meeting_date"]).strftime("%d %b %y")
            flag = "" if r["meeting_type"] == "Official" else " *"
            box = widgets.FloatText(value=round(float(r["implied_policy_rate"]), 3),
                                    layout=widgets.Layout(width="96px"))
            box.observe(self._on_scn_input, names="value")
            cells.append(widgets.VBox(
                [widgets.HTML(f"<div style='font-size:11px;color:#aaa'>{lbl}{flag}</div>"),
                 box], layout=widgets.Layout(margin="0 8px 8px 0")))
            self.scn_inputs.append(box)

        self.scn_grid.children = [
            widgets.GridBox(cells, layout=widgets.Layout(
                grid_template_columns="repeat(6, 112px)")),
            widgets.HTML("<div style='color:#888;font-size:11px'>"
                         "* estimated meeting date, not announced</div>")]

        hz = int(reliable_horizon(self.curve))
        opts = [(f"{int(d)}d (~{d/365:.1f}y)", int(d))
                for d in self.curve.node_days[1:] if 0 < d <= hz]
        self._set_select(self.pos_tenor, opts, opts[-1][1] if opts else None)

    def _scn_reset(self):
        for b, v in zip(self.scn_inputs, self.path["implied_policy_rate"]):
            b.value = round(float(v), 3)
        self._render_scenario()

    def _scn_shift(self):
        bp = float(self.scn_shift.value) / 100.0
        for b, v in zip(self.scn_inputs, self.path["implied_policy_rate"]):
            b.value = round(float(v) + bp, 3)
        self._render_scenario()

    # ---------------- lifecycle ----------------

    def display(self):
        display(self.root)

    def _recompute(self, _c=None):
        self.run()

    def _country_changed(self, change):
        global CFG
        CFG = COUNTRIES[change["new"]]
        for w in (self.policy, self.effective):
            try:
                w.unobserve(self._recompute, names="value")
            except ValueError:
                pass
        self.policy.value = 0.0
        self.effective.value = 0.0
        self.conv.value = CFG.business_day_convention
        self.spot_lag.value = CFG.spot_lag_bd
        for w in (self.policy, self.effective):
            w.observe(self._recompute, names="value")
        self.run()

    def _probe(self):
        with self.status:
            clear_output()
            res, note = probe_native_wirp(pd.Timestamp.today().normalize())
            colour = "#4caf50" if res is not None else "#ff9800"
            display(DisplayHTML(f"<div style='color:{colour};font-size:12px'>{note}</div>"))

    def run(self):
        global CFG
        try:
            CFG = COUNTRIES[self.country.value]
            self._conv_override()

            as_of = pd.Timestamp.today().normalize()
            eff = float(self.effective.value) or None
            pol = float(self.policy.value) or None

            if eff is None:
                live_eff, self.eff_source = load_effective_rate(as_of)
                if live_eff is not None:
                    eff = live_eff
            else:
                self.eff_source = "manual entry"

            if pol is None:
                live, src = load_policy_rate(as_of)
                if live is not None:
                    pol = live
                    self.policy_source = src
                else:
                    self.policy_source = src
            else:
                self.policy_source = "manual entry"

            self.path, self.curve, self.curve_df, self.solved, self.eff_rate = \
                path_for(as_of, eff, pol, self.extend.value)
            self.as_of_used = as_of
            self.policy_rate = pol if pol is not None else self.eff_rate

            self.n_suppressed = 0
            if "beyond_curve" in self.path:
                self.n_suppressed = int(self.path["beyond_curve"].sum())
                keep = self.path[~self.path["beyond_curve"]]
                if not keep.empty:
                    self.path = keep.reset_index(drop=True)

            self._rebuild_scenario_grid()
            self._render_status()
            for stage, fn in (("WIRP view", self._render_main),
                              ("forward curve", self._render_forward),
                              ("scenario", self._render_scenario),
                              ("curve", self._render_curve),
                              ("methodology", self._render_method)):
                try:
                    fn()
                except Exception as exc:
                    print(f"[{stage} render failed] {type(exc).__name__}: {exc}")

        except Exception as exc:
            with self.status:
                clear_output()
                display(DisplayHTML(
                    f"<div style='color:#ff6666;font-family:monospace'>"
                    f"<b>ERROR:</b> {type(exc).__name__}: {exc}</div>"))

    def _conv_override(self):
        """Roll and spot-lag dropdowns override the country default."""
        global CFG
        CFG = CountryConfig(**{**CFG.__dict__,
                               "business_day_convention": self.conv.value,
                               "spot_lag_bd": int(self.spot_lag.value)})

