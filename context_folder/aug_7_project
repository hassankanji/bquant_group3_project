def build_meetings(as_of, end=HORIZON_END, extend=True):
    as_of = pd.Timestamp(as_of).normalize()
    end = pd.Timestamp(end).normalize()

    official = sorted(d for d in CFG.official_meetings if as_of < d <= end)
    rows = [{"meeting_date": d, "meeting_type": "Official"} for d in official]

    if extend:
        anchor = official[-1] if official else as_of
        nxt = anchor + pd.Timedelta(days=CFG.estimated_cadence_days)
        while nxt <= end:
            while nxt.weekday() >= 5:
                nxt += pd.Timedelta(days=1)
            rows.append({"meeting_date": nxt, "meeting_type": "Estimated"})
            nxt = nxt + pd.Timedelta(days=CFG.estimated_cadence_days)

    cal = pd.DataFrame(rows).sort_values("meeting_date").reset_index(drop=True)
    if cal.empty:
        return cal
    cal["days_from_as_of"] = (cal["meeting_date"] - as_of).dt.days
    return cal


def implied_path(curve, cal, effective_rate, as_of, policy_rate=None):
    """Forward-starting par rate from each meeting to the next."""
    if cal.empty:
        return cal

    as_of = pd.Timestamp(as_of).normalize()
    out = cal.copy()
    starts = out["days_from_as_of"].astype(int).tolist()
    ends = starts[1:] + [starts[-1] + CFG.estimated_cadence_days]

    par, cc = [], []
    for s, e in zip(starts, ends):
        sd = adjust(as_of + pd.Timedelta(days=int(s)))
        ed = adjust(as_of + pd.Timedelta(days=int(e)))
        par.append(forward_par_rate_dates(curve, as_of, sd, ed))
        cc.append(curve.cc_forward((sd - as_of).days, (ed - as_of).days))

    out["implied_overnight_rate"] = par
    out["cc_forward"] = cc

    prev = np.r_[float(effective_rate), out["implied_overnight_rate"].to_numpy()[:-1]]
    out["move_bps"] = (out["implied_overnight_rate"].to_numpy() - prev) * 100.0
    out["number_of_moves"] = out["move_bps"] / CFG.standard_move_bps
    out["cumulative_bps"] = out["move_bps"].cumsum()

    basis = 0.0 if policy_rate is None else float(policy_rate) - float(effective_rate)
    out["policy_effective_basis"] = basis
    out["implied_policy_rate"] = out["implied_overnight_rate"] + basis

    horizon = reliable_horizon(curve)
    win_end = np.r_[out["days_from_as_of"].to_numpy()[1:],
                    out["days_from_as_of"].to_numpy()[-1] + CFG.estimated_cadence_days]
    out["window_end_day"] = win_end
    out["beyond_curve"] = win_end > horizon
    out["as_of_date"] = as_of
    return out


def meeting_resolution(curve, path):
    """
    Meetings sharing a flat forward segment cannot be told apart. The split
    shown between them comes from where the window boundaries land, not
    from pricing.
    """
    if path is None or path.empty:
        return pd.DataFrame()

    as_of = pd.Timestamp(path["as_of_date"].iloc[0]).normalize()
    starts = path["days_from_as_of"].astype(int).tolist()
    ends = starts[1:] + [starts[-1] + CFG.estimated_cadence_days]

    rows = []
    for (_, r), s, e in zip(path.iterrows(), starts, ends):
        a = (adjust(as_of + pd.Timedelta(days=int(s))) - as_of).days
        b = (adjust(as_of + pd.Timedelta(days=int(e))) - as_of).days
        inside = int(((curve.node_days > a) & (curve.node_days < b)).sum())
        k = max(int(np.searchsorted(curve.node_days, a, side="left")), 1)
        if k < len(curve.node_days):
            lo, hi = curve.node_days[k - 1], curve.node_days[k]
            seg, width = f"({lo:.0f},{hi:.0f}]", int(hi - lo)
        else:
            seg, width = "tail", -1
        rows.append({
            "meeting": pd.Timestamp(r["meeting_date"]).date(),
            "nodes_in_window": inside,
            "segment": seg,
            "segment_width_days": width,
            "independently_priced": "yes" if inside > 0 else "NO",
            "implied_move_bps": round(float(r["move_bps"]), 2),
        })
    return pd.DataFrame(rows)


def path_for(as_of, effective_rate=None, policy_rate=None, extend=True):
    as_of = pd.Timestamp(as_of).normalize()
    curve_df = load_curve(as_of)
    curve, solved = bootstrap_cc_forwards(
        curve_df.tenor_days, curve_df.par_rate, as_of, curve_df["maturity"])

    if effective_rate is None:
        s = spot_date(as_of)
        effective_rate = forward_par_rate_dates(
            curve, as_of, s, adjust(s + pd.Timedelta(days=CFG.coupon_freq_days)))

    cal = build_meetings(as_of, HORIZON_END, extend)
    path = implied_path(curve, cal, effective_rate, as_of, policy_rate)
    return path, curve, curve_df, solved, effective_rate


