                             range=[lo - pad, hi + pad], secondary_y=True)
            fig.update_layout(
                title=f"{CFG.name}: Implied Overnight Rate & Implied Policy Rate",
                template="plotly_dark", height=600,
                legend=dict(orientation="h"), hovermode="x unified")
            fig.show()

            table = p[["meeting_date", "implied_policy_rate", "implied_overnight_rate",
                       "cc_forward", "move_bps", "number_of_moves",
                       "cumulative_bps", "meeting_type"]].copy()
            table.columns = ["Meeting", "Implied Policy Rate", "Implied O/N Rate",
                             "CC Forward", "Move (bp)", "# Moves",
                             "Cumulative (bp)", "Type"]
            table["Meeting"] = pd.to_datetime(table["Meeting"]).dt.date
            for c in table.columns[1:-1]:
                table[c] = table[c].astype(float).round(3)
            display(DisplayHTML("<h3>Meeting-by-Meeting Pricing</h3>"))
            display(table)

    def _render_forward(self):
        with self.fwd_out:
            clear_output()
            build_forward_curve_figure(self.curve, self.path,
                                       self.as_of_used, self.policy_rate).show()

    def _render_scenario(self):
        with self.scn_out:
            clear_output()
            if self.path is None or not self.scn_inputs:
                return
            try:
                proj = np.array([float(b.value) for b in self.scn_inputs])
                mkt = self.path["implied_policy_rate"].to_numpy(float)
                basis = self.policy_rate - self.eff_rate

                scen = scenario_curve_from_path(
                    self.as_of_used,
                    self.path["days_from_as_of"].astype(int).tolist(),
                    proj - basis, self.eff_rate)

                diff = (proj - mkt) * 100.0
                term = diff[-1]

                pos = None
                if self.pos_tenor.value:
                    s = spot_date(self.as_of_used)
                    e = adjust(self.as_of_used
                               + pd.Timedelta(days=int(self.pos_tenor.value)))
                    pos = scenario_position(
                        self.curve, scen, self.as_of_used, s, e,
                        float(self.pos_notional.value) * 1e6,
                        self.pos_side.value == "Pay fixed")

                def card(l, v, sub="", col=""):
                    c = f";color:{col}" if col else ""
                    s = f"<small style='color:#888'>{sub}</small>" if sub else ""
                    return ("<div style='background:#222;border:1px solid #555;"
                            "border-radius:8px;padding:12px;min-width:170px'>"
                            f"<span style='color:#aaa;font-size:11px'>{l}</span>"
                            f"<b style='display:block;font-size:20px{c}'>{v}</b>{s}</div>")

                cards = [card("MARKET TERMINAL", f"{mkt[-1]:.3f}%"),
                         card("YOUR TERMINAL", f"{proj[-1]:.3f}%"),
                         card("TERMINAL GAP", f"{term:+.0f} bp",
                              f"{term / CFG.standard_move_bps:+.2f} standard moves",
                              "#4caf50" if term >= 0 else "#ef5350")]
                if pos:
                    cards += [card("DV01", f"{pos['dv01']:,.0f}",
                                   f"{CFG.currency} per bp"),
                              card("SWAP RATE MOVE", f"{pos['rate_change_bps']:+.1f} bp",
                                   f"{pos['market_rate']:.3f} &rarr; {pos['scenario_rate']:.3f}"),
                              card("SCENARIO P&amp;L", f"{pos['pnl']:,.0f}",
                                   CFG.currency,
                                   "#4caf50" if pos['pnl'] >= 0 else "#ef5350")]
                display(DisplayHTML(
                    "<div style='display:flex;gap:10px;flex-wrap:wrap;margin:12px 0'>"
                    + "".join(cards) + "</div>"))

                x = ["Current"] + [pd.Timestamp(d).strftime("%d %b %y")
                                   for d in self.path["meeting_date"]]
                fig = make_subplots(specs=[[{"secondary_y": True}]])
                fig.add_trace(go.Scatter(x=x, y=[self.policy_rate] + list(mkt),
                                         mode="lines+markers",
                                         name="Market implied policy rate",
                                         line=dict(width=3, color=COLORS[0])),
                              secondary_y=False)
                fig.add_trace(go.Scatter(x=x, y=[self.policy_rate] + list(proj),
                                         mode="lines+markers",
                                         name="Your projected path",
                                         line=dict(width=3, color=COLORS[1],
                                                   dash="dash")),
                              secondary_y=False)
                fig.add_trace(go.Bar(x=x[1:], y=diff,
                                     marker_color=np.where(diff >= 0, "#4caf50", "#ef5350"),
                                     name="You minus market (bp)", opacity=0.45),
                              secondary_y=True)
                fig.update_yaxes(title_text="Policy rate (%)", secondary_y=False)
                fig.update_yaxes(title_text="Difference (bp)", secondary_y=True)
                fig.update_layout(title=f"{CFG.name}: Projected Path vs Market Pricing",
                                  template="plotly_dark", height=520,
                                  legend=dict(orientation="h"),
                                  hovermode="x unified", xaxis=dict(type="category"))
                fig.show()

                tbl = pd.DataFrame({
                    "Meeting": pd.to_datetime(self.path["meeting_date"]).dt.date,
                    "Market": mkt.round(3), "Your path": proj.round(3),
                    "Diff (bp)": diff.round(1),
                    "Type": self.path["meeting_type"].values})
                display(DisplayHTML("<h3>Path vs Market</h3>"))
                display(tbl)
                display(DisplayHTML(
                    "<div style='color:#888;font-size:11px;margin-top:10px'>"
                    "P&amp;L is an instantaneous reprice: no carry, no roll-down, "
                    "no spread change. Meetings sharing a flat forward segment "
                    "cannot be separated by the curve, so the market column "
                    "between them is a split rather than pricing.</div>"))
            except Exception as exc:
                display(DisplayHTML(
                    f"<div style='color:#ff6666;font-family:monospace'>"
                    f"<b>SCENARIO ERROR:</b> {type(exc).__name__}: {exc}</div>"))

    def _render_curve(self):
        with self.curve_out:
            clear_output()
            fig = go.Figure()
            fig.add_trace(go.Scatter(x=self.curve_df["tenor_days"],
                                     y=self.curve_df["par_rate"],
                                     mode="lines+markers", name="Bloomberg Curve Rate"))
            fig.update_layout(title=f"{CFG.name} — {CFG.curve_ticker}",
                              xaxis_title="Days to maturity",
                              yaxis_title="Par rate (%)",
                              template="plotly_dark", height=420)
            fig.show()

            nd = self.curve.node_days
            gaps = pd.DataFrame({"from_day": nd[:-1].astype(int),
                                 "to_day": nd[1:].astype(int),
                                 "width_days": (nd[1:] - nd[:-1]).astype(int)})
            wide = gaps[(gaps.width_days >= 60) & (gaps.from_day <= 800)]
            n1y = int((nd > 0).sum() - (nd > 365).sum())
            display(DisplayHTML(
                f"<h3>Node Density</h3><p><b>{n1y}</b> nodes inside the first year "
                f"against 8 policy meetings a year. Fewer than 8 means some meetings "
                f"cannot be resolved separately no matter what.</p>"
                + ("<p style='color:#ff9800'>Wide flat blocks below.</p>"
                   if not wide.empty else
                   "<p style='color:#4caf50'>No block wider than 60 days inside 2Y.</p>")))
            if not wide.empty:
                display(wide)

            chk = reprice_check(self.curve, self.curve_df.tenor_days,
                                self.curve_df.par_rate, self.as_of_used,
                                self.curve_df["maturity"])
            worst = float(chk.error_bps.abs().max())
            col = "#4caf50" if worst < 1e-6 else "#ff6666"
            display(DisplayHTML(
                f"<h3>Bootstrap Repricing Check</h3>"
                f"<p>Max error <b style='color:{col}'>{worst:.2e} bp</b>. This is "
                f"zero by construction, so it validates the interpolation and NOT "
                f"the convention: a wrong coupon frequency would still reprice "
                f"perfectly. Forwards flat past the last node at "
                f"<b>{self.curve.fwds[-1]*100:.4f}%</b>.</p>"))
            display(chk.round(10))

            display(DisplayHTML("<h3>Meeting Resolution</h3>"))
            display(meeting_resolution(self.curve, self.path))

            display(DisplayHTML("<h3>Curve Members</h3>"))
            shown = self.curve_df.copy()
            for c in shown.select_dtypes("number").columns:
                shown[c] = shown[c].round(6)
            display(shown)

            display(DisplayHTML("<h3>Bootstrapped CC Forwards</h3>"))
            display(self.curve.forward_table().round(6))

    def _render_method(self):
        with self.method:
            clear_output()
            display(DisplayHTML(f"""
            <h3>Methodology</h3>
            <ol>
              <li>Load live Bloomberg curve object <b>{CFG.curve_ticker}</b>
                  ({len(self.curve_df)} members).</li>
              <li>Bootstrap continuously-compounded forwards, piecewise constant
                  between neighbouring instrument maturities. Each instrument solves
                  one segment, so every input reprices at par.</li>
              <li>Before the first maturity the forward equals the first solved
                  value; after the last it is held flat.</li>
              <li>Schedules business-day adjusted on the {CFG.code} calendar
                  ({CFG.business_day_convention}, spot T+{CFG.spot_lag_bd}),
                  {CFG.coupon_freq_days}-day coupons with a single bullet payment
                  at or below {CFG.zero_coupon_max_days} days,
                  ACT/{CFG.day_count_basis:.0f} accrual.</li>
              <li>Each meeting's implied rate is the forward-starting par swap rate
                  from that meeting to the next:
                  <code>(D(start) - D(end)) / Annuity</code>.</li>
              <li>Implied Policy Rate adds a constant policy-minus-effective spread
                  of <b>{(self.policy_rate - self.eff_rate):+.3f}%</b>, held fixed
                  across the horizon.</li>
            </ol>
            <p><b>Convention status:</b> {CFG.convention_status}</p>
            <p><b>Meeting calendar:</b> official dates run through end-2026. Neither
            Chile nor Colombia has published 2027, so 2027 dates are generated at a
            {CFG.estimated_cadence_days}-day cadence and are model assumptions, not
            announced meetings. BanRep sets rates at only 8 of its 12 meetings; the
            ordinary meetings are excluded.</p>
            <p><b>Floating leg</b> is assumed to price to par, with no spread and one
            curve for projection and discounting.</p>
            <p><b>Holiday calendars are encoded from rules, not published lists.</b>
            Measured impact on Mexico was 0.02 bp RMS against FWCV, so node density
            matters far more -- but diff them before anything trades off this.</p>
            """))


