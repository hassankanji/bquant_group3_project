def _first_col(df, names):
    low = {str(c).lower(): c for c in df.columns}
    for n in names:
        if n.lower() in low:
            return low[n.lower()]
    for c in df.columns:
        if any(n.lower() in str(c).lower() for n in names):
            return c
    return None


def _flatten(responses):
    frames = [r.df().reset_index() for r in responses if not r.df().empty]
    if not frames:
        return None
    out = frames[0]
    for nxt in frames[1:]:
        shared = [c for c in ("ID", "DATE") if c in out.columns and c in nxt.columns]
        if shared:
            out = out.merge(nxt.drop_duplicates(shared), on=shared, how="outer")
    return out


def probe_native_wirp(as_of):
    """
    Does bq.data.implied_overnight_rate cover this country? Bloomberg's
    multi-country sample lists Chile but not Mexico or Colombia, so this is
    worth one call before trusting any bootstrap.
    """
    if bq is None:
        return None, "BQL unavailable"
    univ = f"{CFG.code} Country"
    try:
        item = {"r": bq.data.implied_overnight_rate(
            as_of_date=as_of.strftime("%Y-%m-%d"), model="OIS",
            period_reference=bq.func.range(
                f"{as_of:%YM%m}", f"{as_of + pd.DateOffset(years=1):%YM%m}"),
            fill="prev")}
        res = _flatten(bq.execute(bql.Request(univ, item)))
        if res is None or res.empty:
            return None, f"{univ} returned no rows"
        return res, f"{univ} IS supported -- prefer Bloomberg's own numbers"
    except Exception as e:
        return None, f"{univ} not supported: {type(e).__name__}: {e}"


def load_curve(as_of):
    if bq is None:
        raise RuntimeError("BQL unavailable. Run inside BQuant.")
    as_of = pd.Timestamp(as_of).normalize()
    ticker = CFG.curve_ticker

    univ = bq.univ.curvemembers(symbols=ticker)
    raw = _flatten(bq.execute(bql.Request(
        univ, {"curve_rate": bq.data.curve_rate(side="MID"),
               "maturity": bq.data.maturity()})))
    if raw is None:
        raise RuntimeError(f"{ticker} returned no rows.")

    rc, mc = _first_col(raw, ["curve_rate", "rate"]), _first_col(raw, ["maturity"])
    idc = _first_col(raw, ["ID", "ticker"])
    if rc is None or mc is None:
        raise RuntimeError(f"Unexpected columns from {ticker}: {list(raw.columns)}")

    df = pd.DataFrame({
        "member": raw[idc].astype(str) if idc is not None else "",
        "par_rate": pd.to_numeric(raw[rc], errors="coerce"),
        "maturity": pd.to_datetime(raw[mc], errors="coerce"),
    }).dropna(subset=["par_rate", "maturity"])
    df["tenor_days"] = (df["maturity"] - as_of).dt.days
    df = df[(df.tenor_days > 0) & (df.tenor_days <= 10 * 365)]
    df = df.sort_values("tenor_days").drop_duplicates("tenor_days")

    if len(df) < 5:
        raise RuntimeError(f"{ticker}: only {len(df)} usable nodes.")

    df["curve_ticker"] = ticker
    return df.reset_index(drop=True)


def _load_first(tickers):
    """First candidate ticker that returns a value."""
    if bq is None:
        return None, "BQL unavailable"
    for tk in tickers:
        try:
            raw = _flatten(bq.execute(bql.Request([tk], {"px": bq.data.px_last()})))
            if raw is None or raw.empty:
                continue
            v = pd.to_numeric(raw[_first_col(raw, ["px", "value"])],
                              errors="coerce").dropna()
            if not v.empty:
                return float(v.iloc[-1]), tk
        except Exception:
            continue
    return None, "no candidate ticker resolved"


def load_policy_rate(as_of=None):
    """Live policy target, where a ticker is configured."""
    return _load_first(CFG.policy_ticker_candidates)


def load_effective_rate(as_of=None):
    """
    Live overnight index fixing: CHOVCHOV for Chile, COOVIBR for Colombia.

    These are the overnight RFR fixings, not the policy target, so they
    belong in Effective. Falling back to the curve's front stub when no
    ticker resolves.
    """
    return _load_first(CFG.effective_ticker_candidates)


