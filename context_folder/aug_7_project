def _easter(y):
    a, b, c = y % 19, y // 100, y % 100
    d, e = b // 4, b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = c // 4, c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    return pd.Timestamp(year=y, month=(h + l - 7 * m + 114) // 31,
                        day=((h + l - 7 * m + 114) % 31) + 1)


def _nth(y, mo, wd, n):
    d = pd.Timestamp(year=y, month=mo, day=1)
    return d + pd.Timedelta(days=(wd - d.weekday()) % 7 + 7 * (n - 1))


def _next_monday(d):
    d = pd.Timestamp(d)
    return d if d.weekday() == 0 else d + pd.Timedelta(days=(7 - d.weekday()) % 7)


@lru_cache(maxsize=None)
def mx_holidays(y):
    """Banxico dias inhabiles. Mexican holidays do not roll off weekends."""
    e = _easter(y)
    h = {pd.Timestamp(y, 1, 1), _nth(y, 2, 0, 1), _nth(y, 3, 0, 3),
         e - pd.Timedelta(days=3), e - pd.Timedelta(days=2),
         pd.Timestamp(y, 5, 1), pd.Timestamp(y, 9, 16), _nth(y, 11, 0, 3),
         pd.Timestamp(y, 12, 12), pd.Timestamp(y, 12, 25)}
    if (y - 2024) % 6 == 0:
        h.add(pd.Timestamp(y, 12, 1))       # presidential transmission
    return frozenset(h)


@lru_cache(maxsize=None)
def cl_holidays(y):
    """Chilean feriados including the 31 Dec bank holiday."""
    e = _easter(y)
    h = {pd.Timestamp(y, 1, 1), e - pd.Timedelta(days=2), e - pd.Timedelta(days=1),
         pd.Timestamp(y, 5, 1), pd.Timestamp(y, 5, 21), pd.Timestamp(y, 6, 20),
         pd.Timestamp(y, 7, 16), pd.Timestamp(y, 8, 15),
         pd.Timestamp(y, 9, 18), pd.Timestamp(y, 9, 19),
         pd.Timestamp(y, 10, 31), pd.Timestamp(y, 11, 1),
         pd.Timestamp(y, 12, 8), pd.Timestamp(y, 12, 25),
         pd.Timestamp(y, 12, 31)}
    # San Pedro y San Pablo and Dia de la Raza shift to Monday when Tue-Thu
    for d in (pd.Timestamp(y, 6, 29), pd.Timestamp(y, 10, 12)):
        h.add(d - pd.Timedelta(days=d.weekday()) if d.weekday() in (1, 2, 3) else d)
    return frozenset(h)


@lru_cache(maxsize=None)
def co_holidays(y):
    """Colombian holidays. Ley Emiliani moves many of them to the next Monday."""
    e = _easter(y)
    fixed = {pd.Timestamp(y, 1, 1), pd.Timestamp(y, 5, 1), pd.Timestamp(y, 7, 20),
             pd.Timestamp(y, 8, 7), pd.Timestamp(y, 12, 8), pd.Timestamp(y, 12, 25),
             e - pd.Timedelta(days=3), e - pd.Timedelta(days=2)}
    emiliani = [pd.Timestamp(y, 1, 6), pd.Timestamp(y, 3, 19), pd.Timestamp(y, 6, 29),
                pd.Timestamp(y, 8, 15), pd.Timestamp(y, 10, 12),
                pd.Timestamp(y, 11, 1), pd.Timestamp(y, 11, 11)]
    movable = [e + pd.Timedelta(days=43),    # Ascension
               e + pd.Timedelta(days=64),    # Corpus Christi
               e + pd.Timedelta(days=71)]    # Sagrado Corazon
    return frozenset(fixed | {_next_monday(d) for d in emiliani + movable})


_HOLIDAYS = {"MX": mx_holidays, "CL": cl_holidays, "CO": co_holidays}


def is_business_day(d):
    d = pd.Timestamp(d).normalize()
    return d.weekday() < 5 and d not in _HOLIDAYS[CFG.code](d.year)


def adjust(d, conv=None):
    """Modified Following by default: forward, but back if the month changes."""
    conv = conv or CFG.business_day_convention
    d = pd.Timestamp(d).normalize()
    if conv == "NONE":
        return d
    fwd = d
    while not is_business_day(fwd):
        fwd += pd.Timedelta(days=1)
    if conv == "F" or fwd.month == d.month:
        return fwd
    back = d
    while not is_business_day(back):
        back -= pd.Timedelta(days=1)
    return back


def add_business_days(d, n):
    d = pd.Timestamp(d).normalize()
    step = 1 if n >= 0 else -1
    for _ in range(abs(int(n))):
        d += pd.Timedelta(days=step)
        while not is_business_day(d):
            d += pd.Timedelta(days=step)
    return d


def spot_date(as_of):
    return (add_business_days(as_of, CFG.spot_lag_bd) if CFG.spot_lag_bd
            else pd.Timestamp(as_of).normalize())


def tenor_date(base, label, conv=None):
    n, unit = label.split()
    n = int(n)
    base = pd.Timestamp(base)
    raw = (base + pd.DateOffset(months=n) if unit.lower().startswith("mo")
           else base + pd.DateOffset(years=n))
    return adjust(raw, conv)


def swap_schedule(start, end, conv=None):
    """
    Coupon dates rolled backwards from maturity so any stub sits at the
    front, each business-day adjusted. A single bullet payment below
    zero_coupon_max_days, which is how the CLP and COP OIS front ends work.
    """
    start = pd.Timestamp(start).normalize()
    end = pd.Timestamp(end).normalize()
    if (end - start).days <= CFG.zero_coupon_max_days:
        a = adjust(end, conv)
        return [a] if a > start else []

    freq = CFG.coupon_freq_days
    raw, d = [], end
    while d - pd.Timedelta(days=freq) > start:
        raw.append(d)
        d -= pd.Timedelta(days=freq)
    raw.append(d)

    out, seen = [], set()
    for r in sorted(set(raw)):
        a = adjust(r, conv)
        if a > start and a not in seen:
            out.append(a)
            seen.add(a)
    return out


